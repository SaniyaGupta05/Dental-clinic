# Environment mode: development, staging, production
ENVIRONMENT=development
PROJECT_NAME="Kumar Dental Clinic API"
VERSION="1.0.0"

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081"

# Database Configuration (PostgreSQL 16+)
# For local development SQLite can also be used if PostgreSQL is not active:
# DATABASE_URL=sqlite:///./kumar_dental.db
DATABASE_URL=postgresql+psycopg://kumar_admin:kumar_secure_password_123@localhost:5432/kumar_dental_db

# JWT & Authentication Secrets (Use high-entropy keys in production)
JWT_SECRET=kumar_dental_jwt_secret_change_me_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Phone OTP Configuration
# Development only: if true, returns OTP in mock API responses for automated test suites
DEV_OTP_MOCK=true
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Object Storage (S3 / MinIO / Cloudflare R2)
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_secret_password_123
STORAGE_BUCKET_NAME=kumar-dental-private-documents
STORAGE_REGION=ap-south-1

# External Notification Providers (SMS / WhatsApp / Email)
# Set to 'mock' for local development and unit tests
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
EXPO_PUSH_ACCESS_TOKEN=""

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
